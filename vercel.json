{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/run",  "destination": "/api/run.py"  },
    { "source": "/api/logs", "destination": "/api/logs.py" }
  ],
  "functions": {
    "api/run.py":  { "runtime": "@vercel/python@4.3.1" },
    "api/logs.py": { "runtime": "@vercel/python@4.3.1" }
  }
}
