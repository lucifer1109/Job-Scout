# ==============================================================
# Job Scout — Environment Variables Reference
# Copy this to .env and fill in your real values.
# NEVER commit .env to git.
# ==============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here     # console.anthropic.com → API Keys

# --- Slack ---
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/DEFAULT/WEBHOOK
SLACK_SUMMARY_WEBHOOK=https://hooks.slack.com/services/YOUR/OPS/WEBHOOK

# Per-goal channel routing (optional)
# Format: "goal keyword:webhook_url|goal keyword2:webhook_url2"
GOAL_CHANNELS=founders office:https://hooks.slack.com/WEBHOOK1|chief of staff:https://hooks.slack.com/WEBHOOK2

# --- Google Sheets ---
# Get Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
SHEET_ID=your_google_sheet_id_here
SHEET_NAME=job scraper tool master sheet          # fallback if SHEET_ID not set

# Base64-encode your service account JSON:
#   base64 -i your-service-account.json | tr -d '\n'
GOOGLE_CREDS_JSON=your_base64_encoded_service_account_json_here

# --- Search Goals ---
# Comma-separated plain English descriptions of what you're looking for
SEARCH_GOALS=founders office roles in Bengaluru,chief of staff at Series B startups in Mumbai

# --- Tuning (optional — defaults shown) ---
CONFIDENCE_THRESHOLD=7    # Min score (1-10) for a listing to reach Slack
MAX_SLACK_PER_GOAL=10     # Max alerts per goal per run (overflow goes to sheet only)
RESULTS_PER_SITE=25       # Listings fetched per job board per run
HOURS_OLD=72              # Only include listings posted within this many hours
